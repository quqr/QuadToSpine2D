<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>False</PublishAot>
        <PublishTrimmed>False</PublishTrimmed>
        <LangVersion>default</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>QTSAvalonia</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <RootNamespace>QTSAvalonia</RootNamespace>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>embedded</DebugType>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>embedded</DebugType>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.330"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="ObservableCollections" Version="3.3.4"/>
        <PackageReference Include="PanAndZoom" Version="12.0.0.1"/>
        <PackageReference Include="Serilog" Version="4.3.1"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="SkiaSharp" Version="3.119.4"/>
        <PackageReference Include="SukiUI" Version="7.0.1"/>
        <PackageReference Include="SukiUI.Dock" Version="7.0.1"/>
    </ItemGroup>

    <!-- 移除对 ServiceSourceGenerators 的排除项 -->
    <ItemGroup>
        <AvaloniaXaml Remove="QTSCore\bin\**"/>
        <AvaloniaXaml Remove="QTSCore\obj\**"/>
        <AvaloniaXaml Remove="VanillawareConverter\bin\**"/>
        <AvaloniaXaml Remove="VanillawareConverter\obj\**"/>
        <AvaloniaXaml Remove="ServiceGenerators\**"/>
        <AvaloniaXaml Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="QTSCore\bin\**"/>
        <Compile Remove="QTSCore\obj\**"/>
        <Compile Remove="VanillawareConverter\bin\**"/>
        <Compile Remove="VanillawareConverter\obj\**"/>
        <Compile Remove="ServiceGenerators\**"/>
        <Compile Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="QTSCore\bin\**"/>
        <EmbeddedResource Remove="QTSCore\obj\**"/>
        <EmbeddedResource Remove="VanillawareConverter\bin\**"/>
        <EmbeddedResource Remove="VanillawareConverter\obj\**"/>
        <EmbeddedResource Remove="ServiceGenerators\**"/>
        <EmbeddedResource Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Remove="QTSCore\bin\**"/>
        <AdditionalFiles Remove="QTSCore\obj\**"/>
        <AdditionalFiles Remove="VanillawareConverter\bin\**"/>
        <AdditionalFiles Remove="VanillawareConverter\obj\**"/>
        <AdditionalFiles Remove="ServiceGenerators\**"/>
        <AdditionalFiles Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Remove="QTSCore\bin\**"/>
        <AvaloniaResource Remove="QTSCore\obj\**"/>
        <AvaloniaResource Remove="VanillawareConverter\bin\**"/>
        <AvaloniaResource Remove="VanillawareConverter\obj\**"/>
        <AvaloniaResource Remove="ServiceGenerators\**"/>
        <AvaloniaResource Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="QTSCore\bin\**"/>
        <None Remove="QTSCore\obj\**"/>
        <None Remove="VanillawareConverter\bin\**"/>
        <None Remove="VanillawareConverter\obj\**"/>
        <None Remove="ServiceGenerators\**"/>
        <None Remove="Tests\**"/>
    </ItemGroup>

    <!-- 添加对源代码生成器项目的引用 -->
    <ItemGroup>
        <ProjectReference Include="ServiceSourceGenerators\ServiceSourceGenerators\ServiceSourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>

    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
    </ItemGroup>
</Project>